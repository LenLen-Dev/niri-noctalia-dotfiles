# ~/.zshrc — Koru-Fern themed zsh (oh-my-zsh + powerlevel10k).
# Generated by setup-zsh.sh, based on koru-nixos-dotfiles.

# ------------------------------------------------------------------ oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(
  git
  sudo
  colored-man-pages
  extract        # `x <archive>` unpacks anything
  copyfile       # copyfile <f>  -> clipboard (needs wl-clipboard)
  copypath       # copypath      -> clipboard
  fzf-tab
  zsh-autosuggestions
  zsh-syntax-highlighting
)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ------------------------------------------------------------------ options
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS HIST_VERIFY INTERACTIVE_COMMENTS
HISTSIZE=100000
SAVEHIST=100000

# ------------------------------------------------------------------ proxy
# Clash Verge (verge-mihomo) mixed port: HTTP + SOCKS5 on 127.0.0.1:7897.
export http_proxy="http://127.0.0.1:7897"
export https_proxy="http://127.0.0.1:7897"
export all_proxy="socks5://127.0.0.1:7897"
export HTTP_PROXY="$http_proxy"
export HTTPS_PROXY="$https_proxy"
export ALL_PROXY="$all_proxy"
export no_proxy="localhost,127.0.0.1,::1"
export NO_PROXY="$no_proxy"

# Toggle the proxy for the current shell: proxyon / proxyoff
proxyon() {
  export http_proxy="http://127.0.0.1:7897" https_proxy="http://127.0.0.1:7897" \
         all_proxy="socks5://127.0.0.1:7897"
  export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy" ALL_PROXY="$all_proxy"
  print -r -- "proxy on  -> $http_proxy"
}
proxyoff() {
  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
  print -r -- "proxy off"
}

# ------------------------------------------------------------------ aliases
if command -v bat >/dev/null 2>&1; then
  alias cat='bat'
  alias catp='bat -pp'
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias l='eza --icons --group-directories-first -l'
  alias la='eza --icons --group-directories-first -la'
fi
command -v fastfetch >/dev/null 2>&1 && alias fetch='fastfetch'

# ------------------------------------------------------------------ zoxide
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# ------------------------------------------------------------------ fzf
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh) 2>/dev/null || true
  # Win+J/K/L are turned into ESC j/k/l by kitty (Super -> Meta).
  bindkey -r '^R'; bindkey '^R' history-incremental-search-backward
  bindkey -r '^T'; bindkey '^T' transpose-chars
  bindkey -r '^[c'; bindkey '^[c' capitalize-word
  bindkey '^J' accept-line
  bindkey '^K' kill-line
  bindkey '^L' clear-screen
  bindkey '^[j' fzf-history-widget
  bindkey '^[k' fzf-file-widget
  bindkey '^[l' fzf-cd-widget
  # Hand Tab back to fzf-tab (fzf's zsh integration claims it).
  (( $+functions[fzf-tab-complete] )) && bindkey '^I' fzf-tab-complete
fi

# ------------------------------------------------------------------ helpers
# Oh My Zsh defines `ll`/`lt` as aliases (ls wrappers). This must be a
# standalone line *before* the if-block: zsh parses a whole if-block before
# running it, so an unalias inside would be too late.
unalias ll lt 2>/dev/null
if command -v eza >/dev/null 2>&1; then
  # ll [depth] [path] : detailed tree (default depth 1)
  ll() { local d=1; [[ "$1" == <-> ]] && { d="$1"; shift; }; eza --icons --tree --group-directories-first --long -L "$d" "$@"; }
  # lt [depth] [path] : compact tree (default depth 5)
  lt() { local d=5; [[ "$1" == <-> ]] && { d="$1"; shift; }; eza --icons --tree --group-directories-first -L "$d" "$@"; }
fi

if command -v soffice >/dev/null 2>&1; then
  # topdf <input> <target-dir-or-pdf-path>
  topdf() {
    if [ "$#" -ne 2 ]; then echo "usage: topdf <input> <target-dir-or-pdf-path>" >&2; return 2; fi
    local input="$1" target="$2" outdir outname tmp stem
    [ -f "$input" ] || { echo "topdf: no such file: $input" >&2; return 1; }
    input="$(realpath "$input")"
    stem="$(basename "$input")"; stem="${stem%.*}"
    if [ -d "$target" ] || [ "${target%/}" != "$target" ]; then
      outdir="$target"; outname="$stem.pdf"
    else
      outdir="$(dirname "$target")"; outname="$(basename "$target")"
    fi
    mkdir -p "$outdir"
    tmp="$(mktemp -d)" || return 1
    soffice --headless "-env:UserInstallation=file://$tmp/profile" --convert-to pdf --outdir "$tmp" "$input" >/dev/null
    if [ -f "$tmp/$stem.pdf" ]; then
      mv -f "$tmp/$stem.pdf" "$outdir/$outname"; echo "$outdir/$outname"
    else
      echo "topdf: conversion failed: $input" >&2; rm -rf "$tmp"; return 1
    fi
    rm -rf "$tmp"
  }
fi

# ------------------------------------------------------------------ powerlevel10k
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Koru Fern palette (greener variant) overriding the wizard colors.
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIINS_FOREGROUND='#AADD9E'
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VICMD_FOREGROUND='#AADD9E'
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIVIS_FOREGROUND='#AADD9E'
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_VIINS_FOREGROUND='#D39B79'
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_VICMD_FOREGROUND='#D39B79'
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_VIVIS_FOREGROUND='#D39B79'
typeset -g POWERLEVEL9K_DIR_FOREGROUND='#CFDFD0'
typeset -g POWERLEVEL9K_DIR_PATH_SEPARATOR_FOREGROUND='#78907A'
typeset -g POWERLEVEL9K_DIR_PATH_HIGHLIGHT_FOREGROUND='#85C57E'
typeset -g POWERLEVEL9K_DIR_PATH_HIGHLIGHT_BOLD=true
typeset -g POWERLEVEL9K_VCS_FOREGROUND='#85C57E'
typeset -g POWERLEVEL9K_VCS_INCOMING_CHANGESFORMAT_FOREGROUND='#82BFAC'
typeset -g POWERLEVEL9K_VCS_OUTGOING_CHANGESFORMAT_FOREGROUND='#82BFAC'
typeset -g POWERLEVEL9K_TIME_FOREGROUND='#A2B8A4'
typeset -g POWERLEVEL9K_VIRTUALENV_FOREGROUND='#82BFAC'
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND='#DDE07A'
typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND='#A2B8A4'
typeset -g POWERLEVEL9K_CONTEXT_ROOT_TEMPLATE="%F{#DFEBDD}%n%f%F{#A2B8A4}@%m%f"
typeset -g POWERLEVEL9K_CONTEXT_TEMPLATE="%F{#A2B8A4}%n@%m%f"
(( ! $+functions[p10k] )) || p10k reload
# mise（可选：装了才激活）
[ -x "$HOME/.local/bin/mise" ] && eval "$("$HOME/.local/bin/mise" activate zsh)"

# Set timezone to UTC+8 (Asia/Shanghai)
export TZ='Asia/Shanghai'
